local function sendWebhook(url, embed, id, imageUrl)
    local now = os.time()
    local cd = cooldowns[id]
    local last = getLastSent(id)

    if cd > 0 and now - last < cd then
        local remaining = cd - (now - last)
        local cooldownEmbed = {
            embeds = {{
                title = "This sniper is currently on cooldown",
                description = ("**Tired of waiting?** Upgrade to a package and get faster snipes!\nPlease wait **%d seconds** before the next snipe.\nNext ping: <t:%d:R>\n\n[**Click here to buy a ticket!**](https://discord.com/channels/1364275591146246215/1364275591590973552)"):format(remaining, now + remaining),
                color = 16711680
            }}
        }
        req({ Url = url, Method = "POST", Headers = {["Content-Type"] = "application/json"}, Body = HttpService:JSONEncode(cooldownEmbed) })
        return
    end

    setLastSent(id, now)

    local color = id == "tier1" and 0xB0B0B0 or id == "tier2" and 0xFFA500 or id == "tier3" and 0xB400FF or id == "tier4" and 0x2C2F72 or id == "chest2" and 0xFFA500 or id == "chest3" and 0xB400FF or 0x2C2F72

    local payload = {
        embeds = {{
            title = embed.title,
            description = embed.description,
            color = color,
            fields = embed.fields,
            footer = { text = "Created by fabiotestd" },
            thumbnail = { url = imageUrl }
        }}
    }
    req({ Url = url, Method = "POST", Headers = {["Content-Type"] = "application/json"}, Body = HttpService:JSONEncode(payload) })

    if cd > 0 then
        task.delay(1, function()
            local cooldownEmbed = {
                embeds = {{
                    title = "This sniper is currently on cooldown",
                    description = ("**Tired of waiting?** Upgrade to a package and get faster snipes!\nPlease wait **%d seconds** before the next snipe.\nNext ping: <t:%d:R>\n\n[**Click here to buy a ticket!**](https://discord.com/channels/1364275591146246215/1364275591590973552)"):format(cd, now + cd),
                    color = 16711680
                }}
            }
            req({ Url = url, Method = "POST", Headers = {["Content-Type"] = "application/json"}, Body = HttpService:JSONEncode(cooldownEmbed) })
        end)
    end
end

